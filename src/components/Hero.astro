---
import Coin from './Coin.astro';
import Icon from './Icon.astro';
import { HERO_TAGS } from '../data/content';
import { LINKS } from '../data/site';

// A pile of ten coins inside the jar: rows of 4, 3, 2 and 1.
const COIN_RADIUS = 27;
const ROWS = [
  { y: 347, xs: [93, 151, 209, 267] },
  { y: 297, xs: [122, 180, 238] },
  { y: 247, xs: [151, 209] },
  { y: 197, xs: [180] },
];
const coins = ROWS.flatMap((row) => row.xs.map((x) => ({ x, y: row.y })));
---

<section id="inicio" class="relative overflow-hidden pt-28 pb-16 md:pt-40 md:pb-24" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container-page relative grid items-center gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
    <div class="hero-enter flex flex-col gap-6">
      <h1
        class="font-normal tracking-tight text-balance"
        style="font-size: clamp(2.5rem, 1.4rem + 4.6vw, 4.75rem); line-height: 1.04;"
      >
        Ahorra para tu retiro, <span class="text-primary">con lo que puedas</span> y cuando puedas.
      </h1>
      <p class="lead max-w-xl">Sin trámites, sin descargar nada y con todo a la vista.</p>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={LINKS.demo} class="btn btn-primary">
          Probar demo
          <Icon name="arrow-right" />
        </a>
        <a href="#calculadora" class="btn btn-ghost">Calcula cuánto tendrías</a>
      </div>

      <ul class="flex flex-wrap gap-2 pt-2">
        {
          HERO_TAGS.map((tag) => (
            <li class="flex items-center gap-2 rounded-full border border-border bg-surface/70 px-3.5 py-1.5 text-sm text-muted-foreground">
              <span class="size-1.5 rounded-full bg-coin" aria-hidden="true" />
              {tag}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-[21rem] lg:max-w-none" data-hero-art>
      <svg viewBox="0 0 360 400" class="h-auto w-full" aria-hidden="true">
        <g class="coin-float">
          <Coin x={228} y={30} r={COIN_RADIUS} />
        </g>
        <path d="M 50 70 V 336 a 44 44 0 0 0 44 44 H 266 a 44 44 0 0 0 44 -44 V 70" class="jar"></path>
        <path d="M 34 70 H 66 M 294 70 H 326" class="jar"></path>
        {coins.map((coin, i) => <Coin x={coin.x} y={coin.y} r={COIN_RADIUS} drop={i} />)}
      </svg>

      <p
        class="absolute top-[18%] -right-1 flex items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-2 text-sm font-medium shadow-raised md:-right-4"
      >
        <Icon name="wallet" class="text-primary" />
        Saldo en dólares y en pesos
      </p>
      <p
        class="absolute -bottom-5 left-2 flex items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-2 text-sm font-medium shadow-raised md:-left-6"
      >
        <Icon name="shield-check" class="text-positive" />
        Se invierte a tu nombre
      </p>
    </div>
  </div>
</section>

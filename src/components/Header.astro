---
import { LINKS, NAV } from '../data/site';
---

<header class="fixed inset-x-0 top-3 z-40 px-3 md:top-4 md:px-6">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-full border border-border bg-surface/85 py-1.5 pr-1.5 pl-5 shadow-panel backdrop-blur-md"
  >
    <a href="#inicio" class="flex min-h-11 items-center gap-2 text-lg font-medium tracking-tight">
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true">
        <circle cx="12" cy="12" r="10" class="coin-face"></circle>
        <circle cx="12" cy="12" r="6.2" class="coin-ring"></circle>
      </svg>
      Alcancía
    </a>

    <nav aria-label="Secciones" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex min-h-11 items-center rounded-full px-3.5 text-sm text-muted-foreground transition-colors duration-200 hover:bg-muted hover:text-foreground"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={LINKS.register} class="btn btn-primary btn-sm">Empezar a ahorrar</a>
  </div>
</header>

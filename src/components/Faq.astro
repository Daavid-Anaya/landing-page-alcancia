---
import Icon from './Icon.astro';
import { FAQ } from '../data/content';
---

<section id="preguntas" class="section" aria-labelledby="preguntas-titulo">
  <div class="container-page grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="flex flex-col gap-4 lg:sticky lg:top-32 lg:self-start">
      <p class="eyebrow">Dudas</p>
      <h2 id="preguntas-titulo" class="display">Preguntas frecuentes</h2>
    </div>

    <div class="flex flex-col gap-3">
      {
        FAQ.map((item, i) => (
          <details class="panel p-0 md:p-0" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
            <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 px-5 py-4 text-lg font-medium md:px-6">
              {item.question}
              <Icon name="chevron-down" class="faq-chevron text-xl text-muted-foreground" />
            </summary>
            <p class="px-5 pb-5 text-muted-foreground md:px-6 md:pb-6">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
